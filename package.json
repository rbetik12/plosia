{
  "name": "plosia",
  "version": "2.5.0",
  "private": true,
  "description": "Plosia — an online shop for cats and cat food",
  "repository": {
    "type": "git",
    "url": "https://github.com/rbetik12/plosia"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --import ./src/instrument.mjs src/server.mjs",
    "dev": "node --watch --import ./src/instrument.mjs src/server.mjs",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "seed:sentry": "node scripts/seed-sentry.mjs"
  },
  "dependencies": {
    "@sentry/node": "11.8.0",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@sentry/mcp-server": "0.42.0"
  }
}
