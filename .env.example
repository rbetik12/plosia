# Скопируйте в .env (или запустите `npm run setup`) и заполните.
PORT=3000

# --- Токен Sentry (участникам) -------------------------------------------
# Токен только на чтение. Его выдаёт ведущий; в git он не попадает.
# С ним вы сами подключаете Sentry MCP к своему агенту — задание 2 в README.
SENTRY_ACCESS_TOKEN=PASTE_TOKEN_HERE
SENTRY_ORG=rbetik
SENTRY_PROJECT=plosia
